{
   "panels": [
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 0,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "panels": [ ],
         "title": "Stream Throughput",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "ops"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 1
         },
         "id": 2,
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "rate(stream_messages_total{service=~\"$service\"}[$__rate_interval])",
               "intervalFactor": 2,
               "legendFormat": "total"
            }
         ],
         "title": "Total Message Rate (all links)",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "ops"
            }
         },
         "gridPos": {
            "h": 10,
            "w": 24,
            "x": 0,
            "y": 11
         },
         "id": 3,
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "rate(stream_messages_total{service=~\"$service\", from=~\"$from\", to=~\"$to\"}[$__rate_interval])",
               "intervalFactor": 2,
               "legendFormat": "{{from}} → {{to}}"
            }
         ],
         "title": "Message Rate per Link",
         "type": "timeseries"
      },
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 0,
            "x": 24,
            "y": 21
         },
         "id": 4,
         "panels": [ ],
         "title": "Cumulative Counters",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 12,
            "x": 0,
            "y": 22
         },
         "id": 5,
         "options": {
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            }
         },
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "sum(stream_messages_total{service=~\"$service\"}) by (from, to)",
               "intervalFactor": 2,
               "legendFormat": "{{from}} → {{to}}"
            }
         ],
         "title": "Messages Delivered (total)",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "ops"
            }
         },
         "gridPos": {
            "h": 10,
            "w": 12,
            "x": 12,
            "y": 22
         },
         "id": 6,
         "options": {
            "orientation": "horizontal"
         },
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "rate(stream_messages_total{service=~\"$service\"}[$__rate_interval])",
               "intervalFactor": 2,
               "legendFormat": "{{from}} → {{to}}"
            }
         ],
         "title": "Top Busiest Links (msg/s)",
         "type": "bargauge"
      }
   ],
   "refresh": "30s",
   "schemaVersion": 39,
   "tags": [
      "servicelib",
      "streams"
   ],
   "templating": {
      "list": [
         {
            "label": "Datasource",
            "name": "datasource",
            "query": "prometheus",
            "type": "datasource"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": true,
            "label": "Service",
            "multi": true,
            "name": "service",
            "query": "label_values(service_info, service)",
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": true,
            "label": "From",
            "multi": true,
            "name": "from",
            "query": "label_values(stream_messages_total{service=~\"$service\"}, from)",
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": true,
            "label": "To",
            "multi": true,
            "name": "to",
            "query": "label_values(stream_messages_total{service=~\"$service\"}, to)",
            "type": "query"
         }
      ]
   },
   "time": {
      "from": "now-1h",
      "to": "now"
   },
   "timezone": "browser",
   "title": "servicelib / Stream Pipeline",
   "uid": "servicelib-streams"
}
