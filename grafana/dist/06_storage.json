            "x": 0,
            "y": 10
         },
         "id": 5,
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "rate(hashmap_join_storage_evictions_total{service=~\"$service\", name=~\"$storage\"}[$__rate_interval])",
               "intervalFactor": 2,
               "legendFormat": "{{service}} / {{name}}"
            }
         ],
         "title": "Eviction Rate",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 12,
            "x": 12,
            "y": 10
         },
         "id": 6,
         "options": {
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            }
         },
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "sum(hashmap_join_storage_evictions_total{service=~\"$service\", name=~\"$storage\"}) by (service, name)",
               "intervalFactor": 2,
               "legendFormat": "{{service}} / {{name}}"
            }
         ],
         "title": "Total Evictions",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 10,
            "w": 24,
            "x": 0,
            "y": 20
         },
         "id": 7,
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "hashmap_join_storage_count{service=~\"$service\", name=~\"$storage\"}",
               "intervalFactor": 2,
               "legendFormat": "count {{service}}/{{name}}"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "rate(hashmap_join_storage_evictions_total{service=~\"$service\", name=~\"$storage\"}[$__rate_interval])",
               "intervalFactor": 2,
               "legendFormat": "eviction/s {{service}}/{{name}}"
            }
         ],
         "title": "Count vs Eviction Rate (combined)",
         "type": "timeseries"
      }
   ],
   "refresh": "30s",
   "schemaVersion": 39,
   "tags": [
      "servicelib",
      "storage"
   ],
   "templating": {
      "list": [
         {
            "label": "Datasource",
            "name": "datasource",
            "query": "prometheus",
            "type": "datasource"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": true,
            "label": "Service",
            "multi": true,
            "name": "service",
            "query": "label_values(service_info, service)",
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": true,
            "label": "Storage",
            "multi": true,
            "name": "storage",
            "query": "label_values(hashmap_join_storage_count{service=~\"$service\"}, name)",
            "type": "query"
         }
      ]
   },
   "time": {
      "from": "now-1h",
      "to": "now"
   },
   "timezone": "browser",
   "title": "servicelib / Join Storage",
   "uid": "servicelib-storage"
}
