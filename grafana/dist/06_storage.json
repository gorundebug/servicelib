         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "hashmap_join_storage_count{service=~\"$service\", name=~\"$storage\"}",
               "intervalFactor": 2,
               "legendFormat": "{{service}} / {{name}}"
            }
         ],
         "title": "Element Count",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 12,
            "x": 12,
            "y": 1
         },
         "id": 3,
         "options": {
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            }
         },
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "hashmap_join_storage_count{service=~\"$service\", name=~\"$storage\"}",
               "intervalFactor": 2,
               "legendFormat": "{{service}} / {{name}}"
            }
         ],
         "title": "Current Element Count",
         "type": "stat"
      },
      {
