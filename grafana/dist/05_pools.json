            "h": 8,
            "w": 12,
            "x": 12,
            "y": 1
         },
         "id": 3,
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "task_pool_executors_target{service=~\"$service\", name=~\"$pool\"}",
               "intervalFactor": 2,
               "legendFormat": "target {{service}} / {{name}}"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "task_pool_executors_allocated{service=~\"$service\", name=~\"$pool\"}",
               "intervalFactor": 2,
               "legendFormat": "allocated {{service}} / {{name}}"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "task_pool_executors_busy{service=~\"$service\", name=~\"$pool\"}",
               "intervalFactor": 2,
               "legendFormat": "busy {{service}} / {{name}}"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "clamp_min(task_pool_executors_allocated{service=~\"$service\", name=~\"$pool\"} - task_pool_executors_busy{service=~\"$service\", name=~\"$pool\"}, 0)",
               "intervalFactor": 2,
               "legendFormat": "free {{service}} / {{name}}"
            }
         ],
         "title": "Task Pool — Executor State",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
