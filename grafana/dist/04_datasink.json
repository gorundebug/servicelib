               "expr": "sum(datasink_connector_events_total{job=~\"$job\", connector=~\"$connector\", event=\"stop_timeout\"}) by (connector)",
               "intervalFactor": 2,
               "legendFormat": "{{connector}}"
            }
         ],
         "title": "Connector Stop Timeouts (total)",
         "type": "stat"
