            "x": 0,
            "y": 1
         },
         "id": 2,
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "rate(datasink_connector_events_total{job=~\"$job\", connector=~\"$connector\", event=\"stop_timeout\"}[$__rate_interval])",
               "intervalFactor": 2,
               "legendFormat": "{{connector}}"
            }
         ],
         "title": "Connector Stop Timeouts",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
